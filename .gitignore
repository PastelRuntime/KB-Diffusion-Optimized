# --- Things that should never be committed -----------------------------
# Vim recovery files (e.g. .model_b_word_diffusion.py.swp left over from
# editing the Kaggle script on the remote).
.*.swp
*.swp

# Editor / OS scratch
.DS_Store
.vscode/        # uncomment to commit VS Code settings
__pycache__/
*.pyc

# --- Model B weights ---------------------------------------------------
# The intent is to commit them to the fork (see docs/model-b.md and
# .gitattributes — they're routed through Git LFS, not raw git). So by
# default we DO NOT ignore them here. To exclude them from the fork
# (code-only repo), uncomment the two lines below and remove the
# matching lines from .gitattributes.
#
# modelb_v2.zip
# modelb_v2/

# --- Built artifacts from the keyboard model ---------------------------
# export_weights.py writes weights.json for the browser demo. It's
# regenerated by `python export_weights.py`, so most contributors
# shouldn't need to commit it. Uncomment to ignore.
#
# weights.json

# weights live on HF: https://huggingface.co/PastelRuntime/KB-Diffusion-ModelB
modelb_v2.pt
